# ---- PUBLIC (safe in the browser; these are baked into the page at build time) ----
# Solana cluster: devnet (default) or mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public origin of this site, used in coin metadata URIs (must be reachable by wallets and explorers).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Vercel Devnet deployment: https://theorem-pi.vercel.app
# For localhost leave this unset (or use http://localhost:3000).
# Fixed SOL price in USD used for market caps and balances.
NEXT_PUBLIC_SOL_USD=150

# ---- SECRET (server only; never prefix with NEXT_PUBLIC_) ----
# Your RPC provider URL, including its API key. The browser reaches it only through this site's /api/rpc.
# Without it the public Solana endpoint is used, which is rate-limited.
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Use the full HTTPS RPC URL for DEVNET, not just the provider API key.
# Leave NEXT_PUBLIC_SOLANA_RPC_URL unset to keep browser requests on /api/rpc.
